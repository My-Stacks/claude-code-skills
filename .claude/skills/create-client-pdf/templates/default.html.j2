<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ title|default('Client deliverable') }}</title>
<style>
  @page {
    size: Letter;
    margin: 0.85in 0.85in 0.85in 0.85in;
  }
  @page :first {
    margin: 0;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
    font-size: 10.5pt;
    line-height: 1.55;
    color: #1a1a1a;
    -webkit-font-smoothing: antialiased;
  }

  /* ===== COVER ===== */
  .cover {
    page-break-after: always;
    width: 100%;
    /* min-height (not a fixed 11in) + overflow:hidden keeps the cover a
       single full-bleed page without sub-pixel rounding spilling a blank
       second page. */
    min-height: 11in;
    overflow: hidden;
    padding: 1in 0.85in 0.85in 0.85in;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #f8f7f4;
    border-left: 6pt solid #1a1a1a;
  }
  .cover-eyebrow {
    font-size: 9pt;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #6b6b6b;
    margin-bottom: 0.4in;
  }
  .cover-title {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 42pt;
    line-height: 1.05;
    font-weight: 400;
    letter-spacing: -0.02em;
    margin: 0;
    color: #0a0a0a;
  }
  .cover-title .accent {
    font-style: italic;
    color: #7a3d1f;
  }
  .cover-sub {
    font-family: Georgia, serif;
    font-size: 14pt;
    font-weight: 400;
    color: #4a4a4a;
    margin-top: 0.3in;
    line-height: 1.4;
    font-style: italic;
  }
  .cover-meta {
    border-top: 1pt solid #cfcdc7;
    padding-top: 0.3in;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.35in;
    font-size: 9pt;
  }
  .cover-meta dt {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #6b6b6b;
    font-weight: 600;
    font-size: 8pt;
    margin-bottom: 4pt;
  }
  .cover-meta dd {
    margin: 0;
    color: #1a1a1a;
    font-weight: 500;
  }
  .cover-meta .full { grid-column: 1 / -1; }

  /* ===== HEADINGS ===== */
  h1, h2, h3 {
    font-family: Georgia, serif;
    color: #0a0a0a;
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  h1 {
    font-size: 22pt;
    line-height: 1.2;
    margin: 0 0 0.18in 0;
    page-break-after: avoid;
  }
  h2 {
    font-size: 15pt;
    line-height: 1.25;
    margin: 0.35in 0 0.12in 0;
    page-break-after: avoid;
  }
  h2 .sec-num {
    color: #7a3d1f;
    font-style: italic;
    margin-right: 0.12in;
  }
  h3 {
    font-size: 11pt;
    font-family: "Inter", sans-serif;
    font-weight: 700;
    letter-spacing: 0;
    margin: 0.22in 0 0.08in 0;
    color: #1a1a1a;
    page-break-after: avoid;
  }

  /* ===== BODY ===== */
  p {
    margin: 0 0 0.13in 0;
    text-align: left;
    hyphens: none;
  }
  strong { font-weight: 600; color: #0a0a0a; }
  em { font-style: italic; }
  code {
    font-family: "SF Mono", "Menlo", Consolas, monospace;
    font-size: 9.5pt;
    background: #f0eee9;
    padding: 1pt 4pt;
    border-radius: 2pt;
    color: #5a3a1a;
  }
  ul, ol {
    margin: 0.05in 0 0.15in 0;
    padding-left: 0.25in;
  }
  li {
    margin-bottom: 0.06in;
    line-height: 1.5;
  }
  ul li::marker { color: #7a3d1f; }
  ol li::marker { color: #7a3d1f; font-weight: 600; }
  hr {
    border: 0;
    border-top: 0.5pt solid #cfcdc7;
    margin: 0.3in 0;
  }

  /* ===== LEDE ===== */
  /* First paragraph rendered from a leading italic markdown paragraph */
  .lede {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: 11pt;
    color: #2a2a2a;
    line-height: 1.55;
    border-left: 3pt solid #cfcdc7;
    padding: 0.05in 0 0.05in 0.2in;
    margin-bottom: 0.3in;
  }

  .small-note {
    font-size: 9pt;
    color: #6b6b6b;
    font-style: italic;
    margin: 0.05in 0 0.2in 0;
    line-height: 1.5;
  }

  /* ===== TABLES ===== */
  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0.15in 0 0.2in 0;
    font-size: 9.5pt;
    page-break-inside: avoid;
  }
  table.flowing {
    page-break-inside: auto;
  }
  table.flowing thead {
    display: table-header-group;
  }
  table.flowing tbody tr {
    page-break-inside: avoid;
    page-break-after: auto;
  }
  table.flowing tbody tr.tier {
    page-break-after: avoid;
  }
  thead th {
    text-align: left;
    font-size: 8pt;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #6b6b6b;
    padding: 8pt 10pt;
    border-bottom: 1pt solid #1a1a1a;
  }
  tbody td {
    padding: 9pt 10pt;
    border-bottom: 0.5pt solid #e3e1dc;
    vertical-align: top;
    line-height: 1.4;
  }
  tbody tr:last-child td { border-bottom: 1pt solid #1a1a1a; }
  tbody tr.highlight td {
    background: #f8f7f4;
    font-weight: 600;
    color: #0a0a0a;
  }
  tbody tr.tier td {
    background: #0a0a0a;
    color: #f8f7f4;
    font-size: 8pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 6pt 10pt;
    border-bottom: none;
  }
  tbody tr.tier td em {
    font-weight: 400;
    color: #d4b896;
    font-style: italic;
    letter-spacing: 0.06em;
    text-transform: none;
  }
  tbody td.num {
    font-feature-settings: "tnum";
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* ===== ADMONITIONS ===== */
  .adm-callout {
    background: #f8f7f4;
    border-left: 3pt solid #7a3d1f;
    padding: 0.18in 0.22in;
    margin: 0.18in 0;
    page-break-inside: avoid;
  }
  .adm-callout > p:last-child { margin-bottom: 0; }

  .adm-canonical {
    border: 1pt solid #1a1a1a;
    padding: 0.18in 0.22in;
    margin: 0.15in 0;
    page-break-inside: avoid;
  }
  .adm-canonical .adm-label {
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7a3d1f;
    margin-bottom: 6pt;
  }
  .adm-canonical > p {
    font-family: Georgia, serif;
    font-size: 11pt;
    line-height: 1.5;
    margin: 0;
  }
  .adm-canonical > p + p { margin-top: 0.1in; }

  .adm-bottom-line {
    background: #0a0a0a;
    color: #f8f7f4;
    padding: 0.3in 0.35in;
    margin: 0.4in 0 0.2in 0;
    border-radius: 2pt;
    page-break-inside: avoid;
  }
  .adm-bottom-line .adm-label {
    color: #f8f7f4;
    font-family: Georgia, serif;
    font-size: 13pt;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin: 0 0 0.12in 0;
    border-bottom: 0.5pt solid #4a4a4a;
    padding-bottom: 0.1in;
  }
  .adm-bottom-line p { color: #e3e1dc; margin-bottom: 0.1in; }
  .adm-bottom-line p:last-child { margin-bottom: 0; }
  .adm-bottom-line strong { color: #f8f7f4; }
  .adm-bottom-line em { color: #d4b896; }

  .adm-footnote {
    border-top: 0.5pt solid #cfcdc7;
    padding-top: 0.15in;
    margin-top: 0.4in;
    font-size: 8.5pt;
    font-style: italic;
    color: #6b6b6b;
    line-height: 1.5;
  }
  .adm-footnote .adm-label { display: none; }
  .adm-footnote p { font-size: 8.5pt; margin-bottom: 0.05in; }

  /* ===== UTILITY ===== */
  .read-it ul { list-style: none; padding-left: 0; }
  .read-it li {
    padding-left: 0.3in;
    position: relative;
    margin-bottom: 0.12in;
    line-height: 1.5;
  }
  .read-it li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: #7a3d1f;
    font-weight: 600;
  }
</style>
</head>
<body>

<section class="cover">
  <div class="cover-top">
    {% if eyebrow %}<div class="cover-eyebrow">{{ eyebrow }}</div>{% endif %}
    {% if title_main or title_accent %}
    <h1 class="cover-title">{{ title_main or '' }}{% if title_main and title_accent %} {% endif %}{% if title_accent %}<span class="accent">{{ title_accent }}</span>{% endif %}</h1>
    {% elif title %}
    <h1 class="cover-title">{{ title }}</h1>
    {% endif %}
    {% if subtitle %}<p class="cover-sub">{{ subtitle }}</p>{% endif %}
  </div>
  {% if prepared_for or prepared_by or date or status or meta %}
  <dl class="cover-meta">
    {% if prepared_for %}<div><dt>Prepared for</dt><dd>{{ prepared_for }}</dd></div>{% endif %}
    {% if prepared_by %}<div><dt>Prepared by</dt><dd>{{ prepared_by }}</dd></div>{% endif %}
    {% if date %}<div><dt>Date</dt><dd>{{ date }}</dd></div>{% endif %}
    {% if status %}<div><dt>Status</dt><dd>{{ status }}</dd></div>{% endif %}
    {% for item in (meta or []) %}
    <div{% if item.full_width %} class="full"{% endif %}><dt>{{ item.label }}</dt><dd>{{ item.value }}</dd></div>
    {% endfor %}
  </dl>
  {% endif %}
</section>

{{ body|safe }}

</body>
</html>
